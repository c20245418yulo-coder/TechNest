---
import Card from "../../../components/Card.astro";
---

<section id="services">
    <div class="heading">
        <p>WHAT WE OFFER</p>
        <h2>Our Services</h2>
        <span>Smart technology solutions for your business.</span>
    </div>

    <div class="cards">
        <Card
            title="Web Development"
            desc="Creating modern, responsive, and user-friendly websites."
        />

        <Card
            title="Software Development"
            desc="Building customized software to simplify business operations."
        />

        <Card
            title="IT Support"
            desc="Providing reliable technical assistance and troubleshooting."
        />
    </div>
</section>

<style>
    section {
        padding: 96px 8%;
        border-bottom: 1px solid var(--line);
    }

    .heading {
        max-width: 720px;
        margin-bottom: 48px;
    }

    .heading p {
        letter-spacing: 2.5px;
        font-size: 13px;
        font-weight: bold;
        color: var(--accent-soft);
    }

    h2 {
        font-size: clamp(36px, 5vw, 52px);
        letter-spacing: -0.04em;
        margin: 12px 0;
    }

    .heading span {
        color: var(--muted);
    }

    .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    @media (max-width: 768px) {
        .cards {
            grid-template-columns: 1fr;
        }
    }
</style>
