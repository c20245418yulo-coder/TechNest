---
import Card from "../../../components/Card.astro";
---

<section id="process">
    <div class="heading">
        <p>HOW WE WORK</p>
        <h2>Our Process</h2>
        <span>From your ideas to successful digital solutions.</span>
    </div>

    <div class="process-cards">
        <Card
            title="01. Planning"
            desc="We understand your needs, goals, and project requirements."
        />

        <Card
            title="02. Development"
            desc="We design and build digital solutions based on your ideas."
        />

        <Card
            title="03. Delivery"
            desc="We test, improve, and deliver reliable technology solutions."
        />
    </div>
</section>

<style>
    section {
        padding: 80px 10%;
        background-color: #ffffff;
        --text: #132238;
        --muted: #5c6b7a;
        --accent-soft: #1677ff;
        --card-bg: #ffffff;
        --line: rgba(19, 34, 56, 0.12);
        color: var(--text);
    }

    .heading {
        text-align: center;
        margin-bottom: 40px;
    }

    .heading p {
        font-size: 13px;
        font-weight: bold;
        letter-spacing: 3px;
        color: var(--accent-soft);
    }

    h2 {
        font-size: 36px;
        margin: 15px 0;
    }

    .heading span {
        color: var(--muted);
    }

    .process-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    @media (max-width: 768px) {
        .process-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
