---
import Header from "../components/Header.astro";

---

<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TechNest | Building Ideas Through Technology</title>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --page-bg: #f7f7f5;
    --hero-bg: #f7f7f5;
    --section-bg: #f7f7f5;
    --about-bg: #efefec;
    --contact-bg: #f7f7f5;
    --text: #171717;
    --muted: #696966;
    --accent: #171717;
    --accent-soft: #696966;
    --button-bg: #171717;
    --button-hover: #333333;
    --button-text: #ffffff;
    --surface: #ffffff;
    --card-bg: #ffffff;
    --form-bg: #ffffff;
    --input-bg: #ffffff;
    --input-text: #171717;
    --input-border: #d7d7d2;
    --line: #deded8;
    --glass-bg: rgba(247, 247, 245, 0.92);
    --glass-shadow: none;
    --card-shadow: none;
    --card-hover-shadow: none;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --page-bg: #171717;
    --hero-bg: #171717;
    --section-bg: #1d1d1d;
    --about-bg: #222222;
    --contact-bg: #171717;
    --text: #f1f1ee;
    --muted: #aaa9a4;
    --accent: #f1f1ee;
    --accent-soft: #aaa9a4;
    --button-bg: #f1f1ee;
    --button-hover: #d8d8d3;
    --button-text: #171717;
    --surface: #242424;
    --card-bg: #202020;
    --form-bg: #202020;
    --input-bg: #171717;
    --input-text: #f1f1ee;
    --input-border: #494944;
    --line: #393936;
    --glass-bg: rgba(23, 23, 23, 0.92);
    --glass-shadow: none;
    --card-shadow: none;
    --card-hover-shadow: none;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--page-bg);
  }

  body {
    min-height: 100vh;
    margin: 0;
    background-color: var(--page-bg);
    color: var(--text);
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  body,
  header,
  section,
  footer,
  button,
  input,
  textarea,
  .card {
    transition-property: background-color, color, border-color, box-shadow;
    transition-duration: 0.3s;
    transition-timing-function: ease;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
