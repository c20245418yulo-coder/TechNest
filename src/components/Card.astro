---
interface Props {
    title: string;
    desc: string;
    image?: string;
    imageAlt?: string;
}

const { title, desc, image, imageAlt = title } = Astro.props;
---

<div class={`card${image ? " card--image" : ""}`}>
    {image && <img class="card-image" src={image} alt={imageAlt} loading="lazy" decoding="async" />}
    <div class={image ? "card-content" : undefined}>
        <h3>{title}</h3>
        <p>{desc}</p>
    </div>
</div>

<style>
    .card {
        background: var(--card-bg);
        color: var(--text);
        padding: 30px;
        border: 1px solid var(--line);
        border-radius: 12px;
        transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .card--image {
        overflow: hidden;
        padding: 0;
    }

    .card-image {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }

    .card-content {
        padding: 24px;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: var(--card-shadow);
    }

    h3 {
        margin-bottom: 12px;
        font-size: 22px;
    }

    p {
        color: var(--muted);
        line-height: 1.6;
    }
</style>
