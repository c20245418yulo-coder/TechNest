<header class="header">
  <a href="/" class="logo">
    <img src="/images/logo.png" alt="" />
    <span>TechNest</span>
  </a>

  <div class="header-actions">
    <nav>
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#process">Process</a>
      <a href="#about">About</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode">
      Dark mode
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const savedTheme = localStorage.getItem("technest-theme");
    if (savedTheme === "light" || savedTheme === "dark") {
      root.dataset.theme = savedTheme;
    }

    document.addEventListener("DOMContentLoaded", () => {
      const toggle = document.querySelector(".theme-toggle");
      if (!toggle) return;

      const updateToggle = () => {
        const isDark = root.dataset.theme === "dark";
        toggle.textContent = isDark ? "Light mode" : "Dark mode";
        toggle.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} mode`);
      };

      updateToggle();
      toggle.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        localStorage.setItem("technest-theme", nextTheme);
        updateToggle();
      });
    });
  })();
</script>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    margin: 0 auto;
    padding: 18px max(5%, calc((100% - 1280px) / 2));
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: var(--glass-bg);
    box-shadow: none;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    font-size: 22px;
    font-weight: bold;
  }

  .logo img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 2px;
  }

  nav {
    display: flex;
    gap: 25px;
  }

  nav a {
    text-decoration: none;
    color: var(--text);
    font-size: 14px;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--accent-soft);
  }

  .theme-toggle {
    padding: 9px 13px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--about-bg);
  }

  nav a:focus-visible,
  .logo:focus-visible,
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent-soft);
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .header {
      width: 100%;
      flex-direction: column;
      gap: 15px;
      padding: 14px 18px;
    }

    .header-actions {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
    }
  }
</style>

