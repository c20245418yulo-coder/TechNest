---
import Card from "../../../components/Card.astro";
---

<section id="projects" class="projects">
  <h2>Our Projects</h2>
  <p class="subtitle">Some of the solutions we can create for your business.</p>

  <div class="project-grid">
    <Card
      title="Business Website Development"
      desc="A responsive business website with a polished layout and clear user experience."
      image="/images/projects/business-website.jpg"
      imageAlt="Laptop displaying a business analytics website"
    />

    <Card
      title="Software Development"
      desc="Custom software and dashboard interfaces built around your workflow."
      image="/images/projects/software-development.jpg"
      imageAlt="Code and application interface displayed on a computer"
    />

    <Card
      title="IT Support and Solutions"
      desc="Reliable hands-on support for computer hardware and technology."
      image="/images/projects/it-support.jpg"
      imageAlt="Technician working on computer hardware"
    />
  </div>
</section>

<style>
  .projects {
    padding: 80px 8%;
    text-align: center;
    color: #f4f8ff;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 10px;
  }

  .subtitle {
    color: #c6d6e8;
    margin-bottom: 35px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
