---
import Card from "../../../components/Card.astro";
---

<section id="process">
    <div class="heading">
        <p>HOW WE WORK</p>
        <h2>Our Process</h2>
        <span>From your ideas to successful digital solutions.</span>
    </div>

    <div class="process-cards">
        <Card
            title="01. Planning"
            desc="We understand your needs, goals, and project requirements."
        />

        <Card
            title="02. Development"
            desc="We design and build digital solutions based on your ideas."
        />

        <Card
            title="03. Delivery"
            desc="We test, improve, and deliver reliable technology solutions."
        />
    </div>
</section>

<style>
    section {
        padding: 96px 8%;
        background-color: var(--section-bg);
        border-bottom: 1px solid var(--line);
        color: var(--text);
    }

    .heading {
        max-width: 720px;
        margin-bottom: 48px;
    }

    .heading p {
        font-size: 13px;
        font-weight: bold;
        letter-spacing: 2.5px;
        color: var(--accent-soft);
    }

    h2 {
        font-size: clamp(36px, 5vw, 52px);
        letter-spacing: -0.04em;
        margin: 12px 0;
    }

    .heading span {
        color: var(--muted);
    }

    .process-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    @media (max-width: 768px) {
        .process-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
